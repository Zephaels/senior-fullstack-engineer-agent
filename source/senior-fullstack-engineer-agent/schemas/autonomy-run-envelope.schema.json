{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sfse/autonomy-run-envelope.schema.json",
  "title": "SFSE Bounded Production Autonomy Run Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "owner", "issued_at", "expires_at", "environment", "artifact_sha256", "trusted_executables", "environment_bindings", "allowed_actions", "allowed_paths", "allowed_commands", "limits", "health_checks", "rollback", "approval", "hard_stops"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$"},
    "owner": {"type": "string", "minLength": 1, "maxLength": 200},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "environment": {"enum": ["development", "testing", "staging", "production"]},
    "artifact_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "trusted_executables": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    },
    "environment_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inherit", "required_sha256"],
      "properties": {
        "inherit": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
        },
        "required_sha256": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "additionalProperties": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    },
    "allowed_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["build", "test", "package", "canary_deploy", "deploy", "health_check", "observe", "feature_flag", "rollback"]}},
    "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_commands": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_duration_minutes", "max_attempts_per_step", "max_changed_files", "max_cost_usd"],
      "properties": {
        "max_duration_minutes": {"type": "integer", "minimum": 1, "maximum": 1440},
        "max_attempts_per_step": {"type": "integer", "minimum": 1, "maximum": 5},
        "max_changed_files": {"type": "integer", "minimum": 0, "maximum": 10000},
        "max_cost_usd": {"type": "number", "minimum": 0, "maximum": 100000}
      }
    },
    "health_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rollback": {"type": "object", "additionalProperties": false, "required": ["action", "deadline_minutes"], "properties": {"action": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "deadline_minutes": {"type": "integer", "minimum": 1, "maximum": 1440}}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["type", "evidence_ref"], "properties": {"type": {"const": "explicit-preauthorization"}, "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 500}}},
    "hard_stops": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
