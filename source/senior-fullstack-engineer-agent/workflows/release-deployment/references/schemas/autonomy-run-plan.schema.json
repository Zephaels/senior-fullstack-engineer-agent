{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sfse/autonomy-run-plan.schema.json",
  "title": "SFSE Bounded Autonomy Run Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "artifact_path", "workspace", "steps"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{8,128}$"},
    "artifact_path": {"type": "string", "minLength": 1},
    "workspace": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action", "command", "cwd", "timeout_seconds", "transient_exit_codes"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{3,128}$"},
          "action": {"enum": ["build", "test", "package", "canary_deploy", "deploy", "health_check", "observe", "feature_flag"]},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "minLength": 1},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
          "transient_exit_codes": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 255}}
        }
      }
    }
  }
}
