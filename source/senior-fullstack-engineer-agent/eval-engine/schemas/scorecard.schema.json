{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SFSE RC Scorecard",
  "type": "object",
  "required": [
    "version",
    "status",
    "gates"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "GA_GATE_PASS",
        "GA_BLOCKED"
      ]
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "pass"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "pass": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
