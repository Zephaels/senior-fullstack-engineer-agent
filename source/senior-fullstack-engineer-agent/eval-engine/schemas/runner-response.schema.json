{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SFSE Eval Runner Response",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string"
    },
    "selected_skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "output": {
      "type": "string"
    },
    "tool_calls": {
      "type": "array"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
